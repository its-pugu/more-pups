{
	"schemaVersion": 1,
	"id": "more-pups",
	"version": "${version}",
	"name": "More Pups",
	"description": "Adds more dog breeds and items to Minecraft",
	"authors": [
		"Pugu_"
	],
	"contact": {
		"homepage": "https://github.com/YourUsername/more-pups",
